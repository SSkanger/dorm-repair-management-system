# Copy values into your shell environment or a local .env loader of your choice.
# The application does not automatically read .env files.
DORM_REPAIR_DATABASE=C:\path\to\dorm_repair.sqlite3
DORM_REPAIR_SECRET_KEY=replace-with-a-long-random-value
DORM_REPAIR_SESSION_DIR=C:\path\to\private-sessions
DORM_REPAIR_COOKIE_SECURE=0
DORM_REPAIR_DEMO_PASSWORD=use-only-for-non-interactive-seeding

